# Copy to .env. Every key is optional; with none, Dial runs fully simulated.

# PayPal sandbox: developer.paypal.com > Apps & Credentials > Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The sandbox business account that the simulated shops give as their PayPal email
DIAL_SIM_PAYEE=

# Claude runs the typed shop line (/shop-line/:id) and llm: shops. Takes priority over OpenAI for text calls.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
